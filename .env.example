# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL in production. Leave unset for local dev/tests to use embedded PGlite
# (in-memory / local dir ./.local/pglite).
# DATABASE_URL=postgres://user:password@host:5432/taleora
# PGLITE_DATA_DIR=./.local/pglite   (local dev persistence; omit for ephemeral in-memory)

# ─── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET=replace-me-with-a-long-random-string
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=taleora_session

# ─── AI providers ─────────────────────────────────────────────────────────────
# Agnes AI — primary provider (OpenAI-compatible)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_DEFAULT_MODEL=agnes-2.5-flash
# OpenAI-compatible fallback provider (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
# Hugging Face (optional, future)
HF_TOKEN=
# Encryption key for provider secrets at rest (32 bytes hex or base64)
AI_CONFIG_ENCRYPTION_KEY=

# ─── Storage ──────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Payments ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Taleora <noreply@taleora.app>

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_MS=120000

# Optional: enable real pg-boss queue backend (requires real Postgres)
USE_PG_BOSS=false
