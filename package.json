{
  "name": "taleora",
  "version": "1.0.0",
  "private": true,
  "description": "Taleora — AI-powered Story Writing & Humanization Platform",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx --env-file-if-exists=.env worker/src/index.ts",
    "seed": "tsx --env-file-if-exists=.env worker/src/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@hookform/resolvers": "3.9.1",
    "@tanstack/react-query": "5.60.5",
    "@tiptap/extension-placeholder": "2.10.4",
    "@tiptap/pm": "2.10.4",
    "@tiptap/react": "2.10.4",
    "@tiptap/starter-kit": "2.10.4",
    "bcryptjs": "2.4.3",
    "docx": "8.5.0",
    "drizzle-orm": "0.36.4",
    "jose": "5.9.6",
    "jszip": "3.10.2",
    "lucide-react": "0.469.0",
    "next": "14.2.35",
    "pdfkit": "0.15.2",
    "pg": "8.13.1",
    "pg-boss": "10.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.1",
    "tailwindcss": "3.4.19",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "@types/pdfkit": "0.13.4",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.16",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.28.1",
    "postcss": "8.4.49",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
